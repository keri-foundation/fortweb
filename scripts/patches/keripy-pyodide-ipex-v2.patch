+            pre = keys[0].encode() if isinstance(keys[0], str) else keys[0]
+            try:
+                msg = self.cloneEvtMsg(pre=pre, fn=fn, dig=dig, gvrsn=gvrsn)
+            except (MissingEntryError, SerializeError) as ex:
+                continue  # skip this event
+            yield msg
