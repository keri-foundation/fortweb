{
  "name": "fortweb",
  "private": true,
  "type": "module",
  "scripts": {
    "build:runtime": "node tools/build-runtime.mjs",
    "check:runtime-js": "node tools/check-runtime-js.mjs",
    "test:runtime-js-check": "node --test tools/check-runtime-js.test.mjs",
    "test:contract": "node --test tools/runtime-origin-contract-validation.test.mjs",
    "test:closure": "node --test tools/runtime-closure.test.mjs",
    "test:python-deps": "node --test tools/python-dependency-closure.test.mjs",
    "test:build-idempotency": "node --test tools/build-idempotency.test.mjs",
    "test:fast": "node --test tools/runtime-origin-contract-validation.test.mjs tools/runtime-closure.test.mjs tools/python-dependency-closure.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "pretest:e2e": "npm run build:runtime",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3"
  }
}